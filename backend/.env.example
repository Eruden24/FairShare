# Copy this file to .env and fill in your own values.

# --- Database (used by compose.yaml and the app) ---
POSTGRES_DB=fairshare
POSTGRES_USER=fairshare
POSTGRES_PASSWORD=change-me

# --- Auth ---
# Secret used to sign JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
