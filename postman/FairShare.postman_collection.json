											"",
											"// Compare money in cents: 5.01 + 5.00 in floating point isn't exactly 10.01",
											"const cents = amount => Math.round(amount * 100);",
											"",
											"const expense = pm.response.json();",
											"",
											"pm.test(\"amount, currency and split type\", () => {",
											"    pm.expect(expense.amount).to.eql(10.01);",
											"    pm.expect(expense.currency).to.eql(\"EUR\");",
											"    pm.expect(expense.splitType).to.eql(\"EQUAL\");",
											"});",
											"pm.test(\"one share per participant\", () => pm.expect(expense.splits).to.have.lengthOf(2));",
											"pm.test(\"shares add up exactly to the amount\", () => {",
											"    const total = expense.splits.reduce((sum, split) => sum + cents(split.amount), 0);",
											"    pm.expect(total).to.eql(cents(expense.amount));",
											"});",
											"pm.test(\"the extra cent went to exactly one person\", () => {",
											"    pm.expect(expense.splits.map(split => split.amount).sort()).to.eql([5, 5.01]);",
											"});",
											"pm.environment.set(\"expenseId\", expense.id);",
											"pm.environment.set(\"expenseVersion\", expense.version);"
										]
									}
								}
