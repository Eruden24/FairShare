									"script": {
										"type": "text/javascript",
										"exec": [
											"// An expense needs a group you're in, with the second user in it too.",
											"// This works whether you click it alone or run the whole collection (where you just left the group).",
											"const send = (method, path, body) => new Promise((resolve, reject) => pm.sendRequest({",
											"    url: pm.environment.get(\"baseUrl\") + path,",
											"    method,",
											"    header: {",
											"        \"Content-Type\": \"application/json\",",
											"        \"Authorization\": \"Bearer \" + pm.environment.get(\"token\")",
											"    },",
											"    body: body === undefined ? undefined : { mode: \"raw\", raw: JSON.stringify(body) }",
											"}, (err, res) => err ? reject(err) : resolve(res)));",
											"",
											"(async () => {",
											"    const memberEmail = pm.environment.get(\"memberEmail\");",
											"",
											"    // 1. Who am I, and who is the second user? (201 or 409 on register: both fine)",
											"    pm.environment.set(\"userId\", (await send(\"GET\", \"/users/me\")).json().id);",
											"    await send(\"POST\", \"/users\", {",
											"        email: memberEmail, password: pm.environment.get(\"memberPassword\"), displayName: \"Postman Member\"",
											"    });",
											"    const member = await send(\"GET\", \"/users/search?email=\" + encodeURIComponent(memberEmail));",
											"    pm.environment.set(\"memberId\", member.json().id);",
											"",
											"    // 2. A group I'm in: keep {{groupId}} if I can see it, otherwise create one",
											"    const group = await send(\"GET\", \"/groups/\" + pm.environment.get(\"groupId\"));",
											"    if (group.code !== 200) {",
											"        const created = await send(\"POST\", \"/groups\", { name: \"Expenses demo\", currency: \"EUR\" });",
											"        pm.environment.set(\"groupId\", created.json().id);",
											"        console.log(\"Created a group for the expense:\", created.json().id);",
											"    }",
											"",
											"    // 3. The second user in that group (201 = added, 409 = already a member, 403 = I'm not the owner but they're in)",
											"    const added = await send(\"POST\", \"/groups/\" + pm.environment.get(\"groupId\") + \"/members\", { email: memberEmail });",
											"    console.log(\"Ensure member is in group:\", added.code);",
											"})().catch(err => console.error(\"Expense setup failed:\", err));"
										]
									}
								},
